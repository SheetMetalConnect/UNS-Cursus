[
    {
        "id": "tab-work-order-pub",
        "type": "tab",
        "label": "Work Order Publisher (NocoDB → MQTT)",
        "disabled": false,
        "info": "Sessie 5, Deel 2: Poll werkorders uit NocoDB en publiceer naar MQTT.\n\nVervang TABLE_ID_HIER met je tabel ID.\nVervang XC_TOKEN_HIER met je NocoDB API token.\n\nHet verschil met Deel 1: we POSTen niet naar de API,\nmaar publiceren naar MQTT. De bridge flows pakken het daar op."
    },
    {
        "id": "s5b-inject-poll",
        "type": "inject",
        "z": "tab-work-order-pub",
        "name": "Poll (handmatig)",
        "props": [],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "1",
        "topic": "",
        "x": 170,
        "y": 140,
        "wires": [["s5b-get-nocodb"]]
    },
    {
        "id": "s5b-get-nocodb",
        "type": "http request",
        "z": "tab-work-order-pub",
        "name": "GET NocoDB werkorders",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://nocodb:8080/api/v2/tables/TABLE_ID_HIER/records",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [
            {"keyType": "other", "keyValue": "xc-token", "valueType": "other", "valueValue": "XC_TOKEN_HIER"}
        ],
        "x": 400,
        "y": 140,
        "wires": [["s5b-map-payload"]]
    },
    {
        "id": "s5b-map-payload",
        "type": "function",
        "z": "tab-work-order-pub",
        "name": "NocoDB → MQTT payload",
        "func": "var rows = msg.payload.list || [];\n\nvar messages = rows.map(function(r) {\n    return {\n        topic: \"umh/v1/smc/vienna/_work_order/process\",\n        payload: JSON.stringify({\n            order_nr: r.order_nr,\n            product: r.product || \"\",\n            qty: r.qty || 0,\n            customer: r.customer || \"\",\n            priority: r.priority || null,\n            due_date: r.due_date || null,\n            status: r.status || \"Nieuw\"\n        })\n    };\n});\n\nnode.status({text: rows.length + \" werkorders → MQTT\"});\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 140,
        "wires": [["s5b-mqtt-pub", "s5b-debug-orders"]]
    },
    {
        "id": "s5b-mqtt-pub",
        "type": "mqtt out",
        "z": "tab-work-order-pub",
        "name": "Publish → HiveMQ",
        "topic": "",
        "qos": "1",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "s5b-mqtt-broker",
        "x": 650,
        "y": 220,
        "wires": []
    },
    {
        "id": "s5b-debug-orders",
        "type": "debug",
        "z": "tab-work-order-pub",
        "name": "Werkorders",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 880,
        "y": 140,
        "wires": []
    },
    {
        "id": "s5b-mqtt-broker",
        "type": "mqtt-broker",
        "name": "HiveMQ (lokaal)",
        "broker": "hivemq",
        "port": "1883",
        "clientid": "nodered-wo-publisher",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "closeTopic": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    }
]
