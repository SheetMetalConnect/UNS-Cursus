[
    {
        "id": "tab-sales-order-poll",
        "type": "tab",
        "label": "Sales Order Polling (NocoDB → API)",
        "disabled": false,
        "info": "Sessie 5, Deel 1: Poll sales orders uit NocoDB en POST naar UMH Core API.\n\nVervang TABLE_ID_HIER met je tabel ID.\nVervang XC_TOKEN_HIER met je NocoDB API token.\n\nDit is de eenvoudige aanpak: poll → POST → upsert."
    },
    {
        "id": "s5a-inject-poll",
        "type": "inject",
        "z": "tab-sales-order-poll",
        "name": "Poll (handmatig)",
        "props": [],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "1",
        "topic": "",
        "x": 170,
        "y": 140,
        "wires": [["s5a-get-nocodb"]]
    },
    {
        "id": "s5a-get-nocodb",
        "type": "http request",
        "z": "tab-sales-order-poll",
        "name": "GET NocoDB sales_orders",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://nocodb:8080/api/v2/tables/TABLE_ID_HIER/records",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [
            {"keyType": "other", "keyValue": "xc-token", "valueType": "other", "valueValue": "XC_TOKEN_HIER"}
        ],
        "x": 410,
        "y": 140,
        "wires": [["s5a-map-payload"]]
    },
    {
        "id": "s5a-map-payload",
        "type": "function",
        "z": "tab-sales-order-poll",
        "name": "NocoDB → API payload",
        "func": "var rows = msg.payload.list || [];\n\nvar messages = rows.map(function(r) {\n    return {\n        payload: {\n            order_id: r.order_id,\n            customer_name: r.customer_name || \"\",\n            status: r.status || \"Open\",\n            milestone: r.milestone || r.status || \"Open\",\n            due_date: r.due_date || null,\n            order_date: r.order_date || null,\n            delivered_date: null\n        },\n        headers: { \"Content-Type\": \"application/json\" }\n    };\n});\n\nnode.status({text: rows.length + \" sales orders → API\"});\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 140,
        "wires": [["s5a-post-api", "s5a-debug-orders"]]
    },
    {
        "id": "s5a-post-api",
        "type": "http request",
        "z": "tab-sales-order-poll",
        "name": "POST → UMH Core API",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://umh-core:8090/api/v1/",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 640,
        "y": 220,
        "wires": [["s5a-debug-response"]]
    },
    {
        "id": "s5a-debug-orders",
        "type": "debug",
        "z": "tab-sales-order-poll",
        "name": "Sales Orders",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 890,
        "y": 140,
        "wires": []
    },
    {
        "id": "s5a-debug-response",
        "type": "debug",
        "z": "tab-sales-order-poll",
        "name": "API response",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "statusCode",
        "targetType": "msg",
        "statusVal": "statusCode",
        "statusType": "msg",
        "x": 880,
        "y": 220,
        "wires": []
    }
]
