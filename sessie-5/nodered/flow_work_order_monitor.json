[
    {
        "id": "tab-work-order-mon",
        "type": "tab",
        "label": "Work Order Monitor (MQTT feedback)",
        "disabled": false,
        "info": "Sessie 5, Deel 2: Monitor de feedback van de work order bridge flows.\n\nSubscribed op alle _work_order events:\n  - .create    = nieuwe werkorder (nog niet in DB)\n  - .update    = bestaande werkorder, velden gewijzigd\n  - .duplicate = geen verandering, wordt niet opgeslagen\n\nZo zie je precies wat de dedup-flow beslist."
    },
    {
        "id": "s5m-mqtt-sub",
        "type": "mqtt in",
        "z": "tab-work-order-mon",
        "name": "Subscribe _work_order/#",
        "topic": "umh/v1/smc/vienna/_work_order/#",
        "qos": "0",
        "datatype": "utf8",
        "broker": "s5m-mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 140,
        "wires": [["s5m-parse-json", "s5m-debug-topic"]]
    },
    {
        "id": "s5m-parse-json",
        "type": "json",
        "z": "tab-work-order-mon",
        "name": "Parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 430,
        "y": 100,
        "wires": [["s5m-extract-action"]]
    },
    {
        "id": "s5m-extract-action",
        "type": "function",
        "z": "tab-work-order-mon",
        "name": "Toon actie + werkorder",
        "func": "var parts = msg.topic.split('/');\nvar action = parts[parts.length - 1];\nvar orderNr = msg.payload.order_nr || 'onbekend';\nvar customer = msg.payload.customer || '';\n\nvar color = 'grey';\nif (action === 'create') color = 'green';\nif (action === 'update') color = 'blue';\nif (action === 'duplicate') color = 'yellow';\n\nnode.status({fill: color, shape: 'dot', text: action + ': ' + orderNr});\n\nmsg.payload = {\n    actie: action,\n    order_nr: orderNr,\n    klant: customer,\n    status: msg.payload.status,\n    topic: msg.topic\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 100,
        "wires": [["s5m-debug-result"]]
    },
    {
        "id": "s5m-debug-topic",
        "type": "debug",
        "z": "tab-work-order-mon",
        "name": "Raw topic",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "topic",
        "targetType": "msg",
        "statusVal": "topic",
        "statusType": "msg",
        "x": 430,
        "y": 180,
        "wires": []
    },
    {
        "id": "s5m-debug-result",
        "type": "debug",
        "z": "tab-work-order-mon",
        "name": "Resultaat",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 860,
        "y": 100,
        "wires": []
    },
    {
        "id": "s5m-mqtt-broker",
        "type": "mqtt-broker",
        "name": "HiveMQ (lokaal)",
        "broker": "hivemq",
        "port": "1883",
        "clientid": "nodered-wo-monitor",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "closeTopic": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    }
]
