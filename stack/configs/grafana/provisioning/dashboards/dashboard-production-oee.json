    {
      "id": 4,
      "type": "stat",
      "title": "Machine State",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#73BF69", "value": null }]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "RUNNING": { "color": "#73BF69", "index": 0 },
                "STOPPED": { "color": "#F2495C", "index": 1 },
                "IDLE": { "color": "#FF9830", "index": 2 },
                "ERROR": { "color": "#F2495C", "index": 3 }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value FROM tag_string WHERE asset_id = 5 AND tag_name = 'State' AND $__timeFilter(time) ORDER BY time DESC LIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Beschikbaarheid — RunTime vs DownTime",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "RunTimeSec" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } },
              { "id": "displayName", "value": "Run Time (s)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "DownTimeSec" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } },
              { "id": "displayName", "value": "Down Time (s)" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value AS \"RunTimeSec\" FROM tag WHERE asset_id = 5 AND tag_name = 'RunTimeSec' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value AS \"DownTimeSec\" FROM tag WHERE asset_id = 5 AND tag_name = 'DownTimeSec' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series",
          "refId": "B"
        }
      ]
    },
    {
