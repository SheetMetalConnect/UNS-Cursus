  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CycleCount",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#73BF69", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value FROM tag WHERE asset_id = 5 AND tag_name = 'CycleCount' AND $__timeFilter(time) ORDER BY time DESC LIMIT 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
