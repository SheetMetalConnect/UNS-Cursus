            "matcher": { "id": "byName", "options": "CycleTimeMS" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } },
              { "id": "displayName", "value": "Cyclustijd Werkelijk (ms)" }
