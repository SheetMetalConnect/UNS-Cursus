          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value AS \"CycleTimeMS\" FROM tag WHERE asset_id = 5 AND tag_name = 'CycleTimeMS' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time AS time, value AS \"PlannedCycleTimeMS\" FROM tag WHERE asset_id = 5 AND tag_name = 'PlannedCycleTimeMS' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series",
