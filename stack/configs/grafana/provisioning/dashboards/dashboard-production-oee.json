          },
          {
            "matcher": { "id": "byName", "options": "PlannedCycleTimeMS" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } },
              { "id": "displayName", "value": "Cyclustijd Gepland (ms)" },
              {
                "id": "custom.lineStyle",
                "value": { "fill": "dash", "dash": [8, 4] }
