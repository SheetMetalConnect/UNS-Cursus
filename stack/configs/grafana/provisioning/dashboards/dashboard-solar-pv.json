      "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "lineInterpolation": "smooth"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "AC Vermogen (W)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#FF9900", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "DC Vermogen (W)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#FFCC00", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, avg(value) AS \"AC Vermogen (W)\" FROM tag WHERE asset_id = 7 AND tag_name = 'ac.ac_power_w' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "umh-timescaledb" },
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, avg(value) AS \"DC Vermogen (W)\" FROM tag WHERE asset_id = 7 AND tag_name = 'dc.dc_power_w' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
