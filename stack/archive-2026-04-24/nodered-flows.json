    {
        "id": "node-extract-v2",
        "type": "function",
        "z": "tab-polling-v2",
        "name": "v2 → UMH payload",
        "func": "// NocoDB v2: { list: [ { order_nr, product, asset, qty, customer, priority, due_date, status } ] }\nvar rows = msg.payload.list || [];\n\n// Status mapping: NocoDB → UMH event type\nvar statusMap = {\n    \"Nieuw\": \"order.created\",\n    \"Bezig\": \"order.progress\",\n    \"Klaar\": \"order.closed\"\n};\n\nvar messages = rows.map(function(r) {\n    var eventType = statusMap[r.status] || \"order.created\";\n    var payload = {\n        event_type: eventType,\n        line_id: r.asset || \"onbekend\",\n        data: {\n            id: r.order_nr,\n            product_id: r.product || r.order_nr,\n            planned_qty: r.qty || 0,\n            customer: r.customer || null,\n            priority: r.priority || null,\n            due_date: r.due_date || null\n        }\n    };\n\n    // Voor progress/closed: voeg quantity velden toe\n    if (eventType === \"order.progress\" || eventType === \"order.closed\") {\n        payload.data.good_qty = r.qty_completed || 0;\n        payload.data.scrap_qty = r.qty_scrap || 0;\n    }\n\n    return {\n        payload: payload,\n        headers: { \"Content-Type\": \"application/json\" }\n    };\n});\n\nnode.status({text: rows.length + \" werkorders → UNS\"});\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
