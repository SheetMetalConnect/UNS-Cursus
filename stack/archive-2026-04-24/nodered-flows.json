    {
        "id": "node-build-mqtt",
        "type": "function",
        "z": "tab-api-werkorder",
        "name": "Bouw UNS bericht",
        "func": "// Valideer\nif (!msg.payload.order_nr) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"order_nr is verplicht\" };\n    return [null, msg];\n}\n\n// Bouw MQTT payload\nvar werkorder = {\n    order_nr: msg.payload.order_nr,\n    asset: msg.payload.asset || \"onbekend\",\n    qty: msg.payload.qty || 1,\n    status: msg.payload.status || \"Nieuw\",\n    timestamp: new Date().toISOString()\n};\n\n// UNS topic\nmsg.topic = \"umh.v1.smc.workshop.shopfloor.production._raw.werkorder\";\nmsg.payload = JSON.stringify(werkorder);\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 140,
        "wires": [
            [
                "node-mqtt-out",
                "node-ok-response"
            ],
            [
                "node-error-response"
            ]
        ]
    },
