        "id": "node-extract-v3",
        "type": "function",
        "z": "tab-polling-v3",
        "name": "v3 → UMH payload",
        "func": "// NocoDB v3: { records: [ { id, fields: { order_nr, asset, qty, status } } ] }\nvar records = msg.payload.records || [];\n\nvar messages = records.map(function(rec) {\n    var f = rec.fields || rec;\n    return {\n        payload: {\n            event_type: \"order.created\",\n            line_id: f.asset || \"onbekend\",\n            data: {\n                id: f.order_nr,\n                product_id: f.order_nr,\n                planned_qty: f.qty || 0\n            }\n        },\n        headers: { \"Content-Type\": \"application/json\" }\n    };\n});\n\nnode.status({text: records.length + \" werkorders → UNS\"});\nreturn [messages];",
